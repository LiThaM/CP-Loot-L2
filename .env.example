APP_NAME=AdenaLedger
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://adenaledger.com
SUPPORT_EMAIL=support@adenaledger.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,errorlog
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=mailgun
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@adenaledger.com"
MAIL_FROM_NAME="${APP_NAME}"

MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

SUPPORT_MAIL_TO=support@adenaledger.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ----------------------------------------------------------------------------
# AdenaLedgerStats client API (/api/v1/*)
# ----------------------------------------------------------------------------
# Storage backing for client uploads (digit_template_submissions, ocr_samples,
# release binaries, support bot_context). "local" stores in storage/app/client_blobs,
# "s3" routes to a dedicated bucket configurable below.
CLIENT_BLOBS_DISK=local
CLIENT_BLOBS_AWS_KEY=
CLIENT_BLOBS_AWS_SECRET=
CLIENT_BLOBS_AWS_REGION=us-east-1
CLIENT_BLOBS_AWS_BUCKET=
CLIENT_BLOBS_AWS_URL=
CLIENT_BLOBS_AWS_ENDPOINT=
CLIENT_BLOBS_AWS_PATH_STYLE=false

# Shared client key embedded in each .exe release. Must match the key the
# Python client sends via X-Client-Key. Rotated each release. Seeded via
# ClientApiKeySeeder; leave empty to let the seeder generate one.
CLIENT_API_KEY_DEV=

# GeoIP enrichment for telemetry (optional). Supported providers: "maxmind",
# "ipapi", or unset to skip. country_code is nullable, telemetry succeeds anyway.
GEOIP_PROVIDER=
GEOIP_API_KEY=

# Sanctum SPA stateful domains (only relevant when web frontend talks to API).
# SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Discord OAuth (login). Without these the /auth/discord/* endpoints return 503.
# Create app at https://discord.com/developers/applications → OAuth2 → add
# redirect URI matching DISCORD_REDIRECT_URI exactly.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI="${APP_URL}/auth/discord/callback"

VITE_APP_NAME="${APP_NAME}"
